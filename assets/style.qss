/* app/style.qss */

QMainWindow, QWidget#central_widget {
    background-color: #1a1a1a;
}

QWidget#transparent_widget {
    background: transparent;
}

QLabel#main_title {
    color: #ffffff;
    font-size: 20px;
    background: transparent;
    padding: 10px 0;
}

QPushButton#param_btn {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    background: transparent;
    border: none;
    text-align: left;
    padding: 0;
}

QPushButton#param_btn:hover {
    color: rgba(255, 255, 255, 1.0);
}

QPushButton#param_btn:pressed {
    color: rgba(200, 200, 200, 1.0);
}

QLabel#value_label {
    color: #ffffff;
    font-size: 14px;
    background: transparent;
}

QLabel#value_label_empty {
    color: rgba(255, 255, 255, 0.4);
    font-size: 14px;
    font-style: italic;
    background: transparent;
}

QPushButton#generate_btn {
    background: #383838;
    color: #ffffff;
    border: 1px solid #727272;
    border-radius: 8px;
    font-size: 16px;
    padding: 7px 10px;
}

QPushButton#generate_btn:hover {
    background: #505050;
}

QPushButton#generate_btn:pressed {
    background: rgba(100, 100, 100, 0.9);
}

QCheckBox#wt_live_chk {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    background: transparent;
    spacing: 8px;
}

QCheckBox#wt_live_chk:hover {
    color: rgba(255, 255, 255, 1.0);
}

QCheckBox#wt_live_chk::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #727272;
    border-radius: 4px;
    background: transparent;
}

QCheckBox#wt_live_chk::indicator:hover {
    border: 1px solid #ffffff;
}

QCheckBox#wt_live_chk::indicator:checked {
    background: #ffffff;
    border: 1px solid #ffffff;
    image: url(none); 
}

QLabel#copy_marker {
    color: #a0a0a0;
    font-size: 12px;
    background: transparent;
}

QPushButton#value_label {
    color: #ffffff;
    font-size: 14px;
    background: transparent;
    border: none;
    text-align: left;
    padding: 0;
}

QPushButton#value_label:hover {
    color: rgba(255, 255, 255, 0.8);
}

QPushButton#value_label_empty {
    color: rgba(255, 255, 255, 0.4);
    font-size: 14px;
    font-style: italic;
    background: transparent;
    border: none;
    text-align: left;
    padding: 0;
}